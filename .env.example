# Every variable the service reads, with its default (design D-2). Durations take ms, s, m, h or d.

# development writes schema.gql on startup and returns stack traces in GraphQL errors.
NODE_ENV=production
# HTTP port.
PORT=3000
# Redis for the store and the queues.
REDIS_URL=redis://redis:6379
# Geocoding base URL; the stub upstream replaces it in tests and the demo profile.
UPSTREAM_GEOCODING_URL=https://geocoding-api.open-meteo.com
# Forecast base URL; same.
UPSTREAM_FORECAST_URL=https://api.open-meteo.com
# Marine base URL; same.
UPSTREAM_MARINE_URL=https://marine-api.open-meteo.com
# Days returned per activity.
WINDOW_DAYS=7
# Days fetched per ingest; must exceed WINDOW_DAYS so local midnight is covered.
FETCH_DAYS=8
# Data older than this is refetched before it is served.
FRESHNESS_TTL=6h
# Redis key TTL; must exceed FRESHNESS_TTL; how long an outage can be ridden out on stale data.
RETENTION_TTL=24h
# Timeout per upstream call, in milliseconds.
UPSTREAM_TIMEOUT_MS=2000
# Retries per ingest job, with backoff.
UPSTREAM_RETRIES=1
# How long a cold read waits for its jobs, in milliseconds.
COLD_READ_BOUND_MS=4500
# Queue limiter on outbound calls, under Open-Meteo's 600 per minute fair use.
OUTBOUND_PER_MINUTE=500
# Limiter window for OUTBOUND_PER_MINUTE, in milliseconds; test knob; keep the default in production.
OUTBOUND_LIMIT_WINDOW_MS=60000
# Daily outbound guard, under Open-Meteo's 10,000 per day fair use.
OUTBOUND_PER_DAY=9000
# Per-client inbound throttle.
INBOUND_PER_MINUTE=60
# Most rankings selections allowed in one query.
QUERY_MAX_LOCATIONS=5
# Retention of geocode results.
GEOCODE_TTL=30d
# Run queue processors in this process.
QUEUE_PROCESSORS_ENABLED=true
# pino level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
# Telemetry exporter: console or otlp.
OTEL_EXPORTER=console
