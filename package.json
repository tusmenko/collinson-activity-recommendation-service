{
  "name": "activity-ranking-service",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:schema": "vitest run --project schema --passWithNoTests",
    "test:e2e": "vitest run --project e2e",
    "test:cov": "vitest run --coverage",
    "stub:upstream": "node test/stub-upstream/server.ts",
    "load": "node scripts/load.mjs",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run depcruise && pnpm run knip"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "14.0.3",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/graphql": "14.0.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "bullmq": "6.3.14",
    "graphql": "16.14.2",
    "ioredis": "6.0.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.11",
    "autocannon": "8.0.0",
    "dependency-cruiser": "18.6.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "knip": "6.41.0",
    "lefthook": "2.2.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "unplugin-swc": "2.0.0",
    "vitest": "4.1.11"
  }
}
