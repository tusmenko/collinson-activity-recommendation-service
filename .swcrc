{
  "sourceMaps": true,
  "module": { "type": "es6", "resolveFully": true },
  "jsc": {
    "target": "es2023",
    "baseUrl": "./",
    "parser": { "syntax": "typescript", "decorators": true },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true,
      "useDefineForClassFields": true
    },
    "keepClassNames": true,
    "experimental": { "keepImportAttributes": true }
  }
}
